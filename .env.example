# Required secrets. Do not commit a populated .env file.
BOT_TOKEN=replace_with_token_from_botfather
# Optional legacy OpenAI-compatible provider; at least one AI provider key must be configured.
AI_API_KEY=
DATABASE_URL=postgresql+asyncpg://quizbot:change_me@localhost:5432/study_mcq_bot

# AI API configuration. AI_BASE_URL is optional for OpenAI-compatible providers.
AI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
# Optional independent fallbacks. Add keys only for providers you have enabled.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
# Optional authorized AI Seek app endpoint; never commit the token.
AI_SEEK_API_KEY=
AI_SEEK_URL=https://ai-seek.thebetter.ai/v4/chat/send
AI_SEEK_MODELS=qwen/qwen-coder-32b,google/gemini-2.5-flash-lite
AI_SEEK_APP_ID=ai-seek
# Optional device info required only if your authorized account needs it.
AI_SEEK_DEVICE_INFO=
# AI_BASE_URL=https://api.openai.com/v1

# Operations
LOG_LEVEL=INFO
LOG_FILE=runtime_test.log
TIMEZONE=Asia/Kolkata
SCHEDULER_TICK_SECONDS=15
QUESTION_SIMILARITY_THRESHOLD=0.86

# Required only when enabling the Current Affairs subject. The bot refuses to invent current events.
# NEWS_API_KEY=
# NEWS_API_URL=https://newsapi.org/v2/top-headlines

# Global bot administrators, comma-separated. Required for /deliver and /broadcast.
# Group administrators retain group-setting permissions but cannot deliver to other chats.
# ADMIN_USER_IDS=123456789,987654321

# Independent MCQ quality validation. Groq is used when GROQ_API_KEY is available.
VALIDATOR_ENABLED=true
VALIDATOR_CONFIDENCE_THRESHOLD=0.70
VALIDATOR_COOLDOWN_SECONDS=120
# Do not save newly generated AI questions unless an independent validator approves them.
VALIDATOR_REQUIRE_APPROVAL=true

# PDF Source Mode
SOURCE_STORAGE_DIR=source_storage
SOURCE_MAX_PDF_MB=500
SOURCE_OCR_ENABLED=false
# Maximum time for one PDF extraction/OCR job; large scanned PDFs may need several minutes.
SOURCE_INGEST_TIMEOUT_SECONDS=1800
# One private Telegram source group ID. Only ADMIN_USER_IDS can upload/manage PDFs there.
SOURCE_GROUP_ID=-1001234567890
BULK_SOURCE_GROUP_ID=-1001234567890

# Official quiz groups
OFFICIAL_QUIZ_CONFIG_GROUP_ID=-1003511361627
OFFICIAL_QUIZ_PLAY_GROUP_ID=-1003799884627

# Public support links
SUPPORT_CHANNEL_URL=https://t.me/GSI_QUIZ
SUPPORT_GROUP_URL=https://t.me/+OzztqZ23h8AxYWZl
OWNER_CONTACT_URL=https://t.me/Global_X_SohaN

# Background validated question pool. Questions are prepared before delivery.
QUESTION_POOL_ENABLED=true
QUESTION_POOL_TARGET=10
QUESTION_POOL_FILL_PER_TICK=1
QUESTION_POOL_MAX_GROUPS_PER_TICK=2

# Scalable AI request control: avoids API stampedes across many groups.
AI_MAX_CONCURRENT_REQUESTS=4
AI_PROVIDER_COOLDOWN_SECONDS=30
AI_PROVIDER_MIN_INTERVAL_SECONDS=0.5
